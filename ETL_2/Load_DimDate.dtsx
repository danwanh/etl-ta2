      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C1BC2945-47A8-4B66-8462-D9037339EF9D}"
          SQLTask:SqlStatementSource=";WITH n AS (SELECT TOP (4018) ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS i FROM sys.all_objects a CROSS JOIN sys.all_objects b)&#xA;INSERT dbo.DimDate (DateKey, FullDate, [Month], [Quarter], [Year])&#xA;SELECT CONVERT(int, CONVERT(char(8), d, 112)), d, MONTH(d), DATEPART(QUARTER, d), YEAR(d)&#xA;FROM (SELECT DATEADD(DAY, i, CONVERT(date, '2020-01-01')) AS d FROM n) x&#xA;WHERE NOT EXISTS (SELECT 1 FROM dbo.DimDate dd WHERE dd.FullDate = x.d);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
